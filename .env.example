# Naina DM webhook bot — copy to .env and fill in. NEVER commit .env.
# All values come from Meta for Developers + Google AI Studio (see SETUP.md).

# Random string YOU invent — must match the Verify Token you type in Meta's
# webhook settings. Example: use a password generator, 20+ characters.
VERIFY_TOKEN=

# Meta App Secret: App Dashboard -> Settings -> Basic -> App Secret (click Show).
META_APP_SECRET=

# Instagram user access token: API setup with Instagram login -> Generate Token
# (permissions: instagram_business_basic + instagram_business_manage_messages).
# Long-lived token lasts 60 days — refresh it before expiry (see SETUP.md).
IG_ACCESS_TOKEN=

# Naina's Instagram account numeric ID (shown next to the token when you
# generate it). For @its_naina_official1 this is the account's IG ID.
IG_USER_ID=

# Google AI Studio (aistudio.google.com) -> Create API key. FREE tier, no card.
GEMINI_API_KEY=
# Free-tier model for NEW projects (Nov 2026). Do NOT use gemini-2.5-flash —
# it is deprecated for new users and shuts down 1 Dec 2026.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# OPTIONAL fallback if Gemini fails: OpenAI key (paid, only used when set).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Graph API version (v26.0 current as of Nov 2026).
GRAPH_API_VERSION=v26.0

# Human-like pause before replying (ms). Webhook is instant; a real girl isn't.
REPLY_DELAY_MIN_MS=8000
REPLY_DELAY_MAX_MS=20000

# Public URL of this server once deployed (needed to send photos).
# Render example: https://naina-dm-bot.onrender.com
# Vercel example: https://naina-dm-bot.vercel.app
PUBLIC_BASE_URL=

# Port (Render sets PORT automatically; Vercel ignores it).
PORT=3000

# Fan-memory folder (local / Render). On Vercel this is ignored — fan
# memory always uses /tmp/naina-fans there (see memory.js).
# DATA_DIR=./data
